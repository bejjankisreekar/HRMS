DJANGO_SECRET_KEY=change-this-to-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

DB_NAME=hrms
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_HOST=localhost
DB_PORT=5432

TIME_ZONE=Asia/Kolkata
SITE_URL=http://127.0.0.1:8000

SUPERADMIN_EMAIL=superadmin@hrms.com
SUPERADMIN_PASSWORD=Admin@123
SUPERADMIN_USERNAME=superadmin

# CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGINS=

# Contact form — FormSubmit from the browser (portfolio-style; no SMTP required)
CONTACT_INBOX_EMAIL=sreekarbejjanki@gmail.com
FORMSUBMIT_ENABLED=True
FORMSUBMIT_EMAIL=sreekarbejjanki@gmail.com

# Optional Gmail SMTP (visitor auto-reply only; inbox uses FormSubmit by default)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=sreekarbejjanki@gmail.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=HRMS Suite <sreekarbejjanki@gmail.com>

# --- Security (production) ---------------------------------------------------
# DJANGO_DEBUG now defaults to False. Set it True for local development only.
# SSL redirect + secure cookies switch on automatically whenever DEBUG is False;
# override with DJANGO_SECURE_SSL if you terminate TLS somewhere unusual.
# DJANGO_SECURE_SSL=True
#
# HSTS is opt-in. Enable only after HTTPS is confirmed on the real domain -
# browsers cache it hard and it is painful to undo.
# DJANGO_HSTS_SECONDS=31536000
# DJANGO_HSTS_SUBDOMAINS=True
# DJANGO_HSTS_PRELOAD=True
#
# Session lifetime in seconds (default 12h) and log verbosity.
# SESSION_COOKIE_AGE=43200
# DJANGO_LOG_LEVEL=INFO
#
# Last-resort bypass for the production config guard in settings.py. Don't.
# DJANGO_ALLOW_UNSAFE_CONFIG=False

# --- Storage -----------------------------------------------------------------
# Uploads (payslip PDFs, HR letters, attachments, logos). MUST point at a
# persistent volume in production - container filesystems are wiped on redeploy.
# MEDIA_ROOT=/var/data/media

# Reuse DB connections instead of one per request. Keep under the provider's
# idle timeout.
# DB_CONN_MAX_AGE=60

# --- Super Admin -------------------------------------------------------------
# These now live in config.json (see config.json.example); the variables below
# override it when set. Leaving both unset means no Super Admin is auto-created,
# which is the safe default. There is no longer a fallback password in code.
# SUPERADMIN_EMAIL=
# SUPERADMIN_PASSWORD=

# --- Multi-tenancy -----------------------------------------------------------
# Per-org Postgres schema routing. Enable ONLY after `manage.py provision_tenant --all`.
# TENANT_SCHEMA_ROUTING=False
